{
  "name": "jeopardy",
  "version": "1.0.0",
  "description": "A Jeopardy game for Mac",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac"
  },
  "build": {
    "appId": "com.example.jeopardy",
    "productName": "Jeopardy",
    "files": ["index.html", "main.js", "package.json"],
    "mac": { "category": "public.app-category.games", "target": ["dmg"] }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
